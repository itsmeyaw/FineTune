{
  "name": "finetune-browser-extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "effect": "4.1.5"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.4",
    "@types/chrome": "^0.3.8",
    "@types/node": "^26.6.7",
    "oxfmt": "^0.80.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@11.20.0"
}
